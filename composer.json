{
    "name": "survos/otio",
    "description": "PHP OpenTimelineIO document classes and time values.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "otio",
        "opentimelineio",
        "timeline"
    ],
    "require": {
        "php": "^8.5"
    },
    "autoload": {
        "psr-4": {
            "Survos\\Otio\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Survos\\Otio\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    }
}
